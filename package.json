{
  "name": "sesmatch",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "test": "vitest run",
    "test:integration": "DATABASE_URL=postgresql://sesmatch:sesmatch@localhost:5433/sesmatch_test prisma db push --skip-generate --accept-data-loss && DATABASE_URL=postgresql://sesmatch:sesmatch@localhost:5433/sesmatch_test vitest run -c vitest.integration.config.ts"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@aws-sdk/client-sesv2": "^3.1098.0",
    "@prisma/client": "^6.5.0",
    "bcryptjs": "^3.0.2",
    "hono": "^4.7.0",
    "mammoth": "^1.12.0",
    "next": "^15.3.0",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.3",
    "word-extractor": "^1.0.4",
    "xlsx": "^0.18.5",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/word-extractor": "^1.0.6",
    "mssql": "^12.7.0",
    "prisma": "^6.5.0",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vitest": "^3.0.0"
  }
}
