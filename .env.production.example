# 本番環境変数の雛形。.env.production にコピーして値を設定する。
# このファイル自体には実際のシークレットを書かないこと。

# --- データベース ---
POSTGRES_USER=sesmatch
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=sesmatch

# --- アプリ ---
# openssl rand -hex 32 で生成
SESSION_SECRET=CHANGE_ME
# 運営コンソール（/admin）用トークン。openssl rand -hex 24 等で生成
PLATFORM_ADMIN_TOKEN=CHANGE_ME

# --- LLM（優先順: LLM_BASE_URL → ANTHROPIC_API_KEY → モック）---
# ゼロデータ保持・学習オプトアウト契約を確認したプロバイダのみ使用する（§25.4）
LLM_BASE_URL=https://api.lykuro.ai/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=
