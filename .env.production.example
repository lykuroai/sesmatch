# 本番環境変数の雛形。.env.production にコピーして値を設定する。
# このファイル自体には実際のシークレットを書かないこと。

# --- データベース ---
POSTGRES_USER=sesmatch
POSTGRES_PASSWORD=CHANGE_ME_strong_password
POSTGRES_DB=sesmatch

# --- アプリ ---
# openssl rand -hex 32 で生成
SESSION_SECRET=CHANGE_ME
# 運営コンソール（/admin）用トークン。openssl rand -hex 24 等で生成
PLATFORM_ADMIN_TOKEN=CHANGE_ME

# --- LLM（優先順: LLM_BASE_URL → ANTHROPIC_API_KEY → モック）---
# ゼロデータ保持・学習オプトアウト契約を確認したプロバイダのみ使用する（§25.4）
LLM_BASE_URL=https://api.lykuro.ai/v1
LLM_MODEL=deepseek/deepseek-v4-flash
LLM_API_KEY=CHANGE_ME
# ANTHROPIC_API_KEY=

# --- メール配信（Amazon SES）---
# SES で検証済みの送信元。未設定なら送信せずログのみ（モック動作）
MAIL_FROM=
# 送信者の表示名（任意。例: SESMatch）
FROM_NAME=
APP_BASE_URL=https://ses.lykuro.ai
# 運営宛の通知先（お問合せ受付・システムエラー通知 §33.1）。未設定なら通知しない（エラーログの記録は行う）
OPERATIONS_MAIL=
AWS_REGION=ap-northeast-1
# EC2 インスタンスロール（ses:SendEmail 権限）推奨。使えない場合のみ以下を設定
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# --- PRO 版（有料プラン。ses_directmatch_pro_spec_v1_0.md）---
# 保存データの暗号鍵（Webhook URL・2要素の秘密鍵・SSO 設定）。openssl rand -hex 32。未設定なら SESSION_SECRET から派生
DATA_ENCRYPTION_KEY=
# 逆プロキシの信頼段数（IP 制限 §4.12 で X-Forwarded-For の右端から数える）。本番 ALB + nginx は 2
TRUSTED_PROXY_HOPS=2
# Web 会議（§4.8）。Jitsi 本体は別インスタンス。未設定なら機能停止
JITSI_DOMAIN=
JITSI_APP_ID=
JITSI_APP_SECRET=
# カード決済（§4.15。Stripe）。4つ揃うまで機能停止（画面に出ない）。受信 Webhook: POST /api/v1/webhooks/stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=
# 消費税10%の Tax Rate ID（任意。未設定なら価格に税を含める運用）
STRIPE_TAX_RATE_ID=
