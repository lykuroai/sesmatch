# scripts/release-ec2.env にコピーして編集する（コミットしないこと）
# cp scripts/release-ec2.env.example scripts/release-ec2.env

# 必須: EC2 の SSH 接続先
EC2_HOST=ubuntu@203.0.113.10

# SSH 秘密鍵（省略時: ~/.aws/lykuro-prod-key.pem）
#SSH_KEY=$HOME/.aws/lykuro-prod-key.pem

# EC2 上の配置ディレクトリ（省略時: /opt/sesmatch）
#REMOTE_DIR=/opt/sesmatch

# ビルドプラットフォーム（省略時: linux/amd64。Graviton なら linux/arm64）
#PLATFORM=linux/amd64

# EC2 に残す過去イメージの世代数（省略時: 5）
#KEEP_RELEASES=5
